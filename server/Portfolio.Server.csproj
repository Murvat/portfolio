<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);data/**</DefaultItemExcludes>
    <UserSecretsId>portfolio-server-92f18fa4</UserSecretsId>
  </PropertyGroup>
  <Target Name="IncludePortfolioFrontend" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('../dist/index.html')" Text="Run npm run build at the repository root before publishing." />
    <ItemGroup>
      <_PortfolioFrontend Include="$(MSBuildProjectDirectory)/../dist/**/*" />
      <ResolvedFileToPublish Include="@(_PortfolioFrontend)">
        <RelativePath>wwwroot/%(_PortfolioFrontend.RecursiveDir)%(_PortfolioFrontend.Filename)%(_PortfolioFrontend.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
